0010 ' ========================================
0020 ' PROGRAMA: IDENTIFICADOR DE TIPO USR
0030 ' PASSA PARAMETRO PARA FUNCAO ASSEMBLY
0040 ' QUE RETORNA O TIPO DA VARIAVEL
0050 ' ========================================
0060 GOSUB 2000:'CARREGA CODIGO ASSEMBLY
0070 DEFUSR=&HE000  

0200 ' ====== MENU DE TESTES ======
0210 CLS
0220 LOCATE 1,04:? "TESTE DE TIPOS           "
0230 LOCATE 1,05:? "========================="
0280 LOCATE 1,06:? "0-SAIR                   "
0290 LOCATE 1,07:? "1-TESTAR INTEIRO         "
0300 LOCATE 1,08:? "2-TESTAR STRING          "
0310 LOCATE 1,09:? "3-TESTAR SIMPLES PRECISAO"
0320 LOCATE 1,10:? "4-TESTAR DUPLA PRECISAO  "
0330 LOCATE 1,17:? "ESCOLHA UMA OPCAO:       "
0340 LOCATE 27,21:OP$=INPUT$(1)
0350 IF OP$="0" THEN RUN"AUTOEXEC.BAS"
0360 ON VAL(OP$) GOSUB 400,500,600,700
0370 GOTO 210

0400 ' === TESTE INTEIRO ===
0410 A%=300
0420 T%=USR(A%)
0430 GOTO 800

0500 ' === TESTE STRING ===
0510 A$="MSX EH O MELHOR"
0520 T$=USR(A$)
0530 GOTO 1000

0600 ' === TESTE SIMPLES PRECISAO ===
0610 A!=1.23
0620 T!=USR(A!)
0630 GOTO 800

0700 ' === TESTE DUPLA PRECISAO ===
0710 A#=4.5678
0720 T#=USR(A#)
0730 GOTO 800

0800 ' === EXIBE TIPO E VALOR===
0810 FOR I = 4 TO 18
0820   LOCATE 1, I:? STRING$(27," ");
0830 NEXT I
0840 T%=PEEK(&HE030)
0850 V%=PEEK(&HE031)+PEEK(&HE032)*256
0860 LOCATE 1,4:? "TIPO RETORNADO: ";T%
0870 LOCATE 1,5:? "VALOR DO BASIC: ";V%
0880 IF T%=2 THEN LOCATE 1,6:? "INTEIRO (2 BYTES)"
0890 IF T%=4 THEN LOCATE 1,6:? "SIMPLES PRECISAO (4 BYTES)"
0900 IF T%=8 THEN LOCATE 1,6:? "DUPLA PRECISAO (8 BYTES)"
0910 LOCATE 27,21:OP$=INPUT$(1)
0920 GOTO 210

1000 ' === EXIBE TIPO E VALOR EM STRING ===
1010 FOR I = 4 TO 18
1020   LOCATE 1, I:? STRING$(27," ");
1030 NEXT I
1040 LOCATE 1,6:? "STRING"
1050 TA%=PEEK(&HE033)
1060 LOCATE 1,7:? "TAMANHO DA STRING: ";TA%
1070 LOCATE 1,8:? "STRING: ";T$
1080 LOCATE 27,21:OP$=INPUT$(1)
1090 GOTO 210

2000 ' ======================================
2010 ' CARREGA O CODIGO ASSEMBLY      
2020 ' ======================================
2030 RESTORE 3000
2040 E=&HE000
2050 READ R$
2060 IF R$="*" THEN RETURN
2070 POKE E,VAL("&H"+R$)
2080 E=E+1
2090 GOTO 2050

3000 ' =======================================
3010 ' CODIGO ASSEMBLY PARA IDENTIFICAR TIPO
3020 ' =======================================
3030 DATA 3A,63,F6,32,30,E0,FE,03,28,0E,3A,F8
3040 DATA F7,32,31,E0,3A,F9,F7,32,32,E0,18,11
3050 DATA 2A,F8,F7,7E,32,33,E0,23,7E,32,34,E0
3060 DATA 23,7E,32,35,E0,21,30,E0,C9,*